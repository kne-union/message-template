{
  "name": "@kne/message-template",
  "version": "0.1.1",
  "description": "邮件 / 短信等消息模板工具：基于 Liquid 的变量与条件语法定义、渲染、HTML 与纯文本互转，前端与 Node 端通用",
  "syntax": {
    "esmodules": true
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "types": "dist/index.d.ts",
  "source": "src/index.js",
  "scripts": {
    "init": "husky && npm run init-example && npx @kne/npm-tools deployPrompts frontend-libs",
    "start": "run-p start:lib start:md start:example",
    "build": "run-s build:lib build:md build:example",
    "init-example": "modules-dev-libs-init",
    "build:md": "npx @kne/md-doc",
    "start:md": "npx @kne/md-doc --watch",
    "build:lib-main": "microbundle --no-compress --format modern,cjs",
    "build:types": "cp src/index.d.ts dist/",
    "build:lib": "run-s build:lib-main build:types",
    "start:lib": "microbundle watch --no-compress --format modern,cjs",
    "build:example": "cd example && npm run build",
    "start:example": "cd example && npm run start",
    "test": "run-s build:lib test:unit",
    "test:unit": "node --test test/index.test.js",
    "test:build": "run-s build",
    "prettier": "prettier --config .prettierrc --write '{src/**/*,test/**/*,doc/**/*}.{js,jsx,ts,tsx,json,css,scss}'",
    "lint-staged": "npx lint-staged"
  },
  "lint-staged": {
    "{src,test,doc}/**/*.{js,jsx,ts,tsx,json,css,scss}": [
      "prettier --config .prettierrc --write",
      "git add"
    ]
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kne-union/message-template.git"
  },
  "keywords": [
    "message-template",
    "email-template",
    "sms-template",
    "liquid",
    "liquidjs",
    "template-variable",
    "template-condition",
    "html-to-text",
    "isomorphic",
    "nodejs"
  ],
  "author": "linzp",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kne-union/message-template/issues"
  },
  "homepage": "https://github.com/kne-union/message-template#readme",
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@kne/microbundle": "^0.15.5",
    "@kne/modules-dev": "^2.0.33",
    "cross-env": "^7.0.3",
    "husky": "^9.0.11",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "htmlparser2": "^10.1.0",
    "liquidjs": "^10.30.1"
  }
}
